rules_version = '2';

// Sicherheitsregeln fuer Cloud Firestore.
// Kernaussage: Jeder angemeldete Fahrer darf AUSSCHLIESSLICH unter seiner
// eigenen Nutzer-ID lesen und schreiben. Kein Kollege kommt an die Daten
// eines anderen – das ist hier technisch erzwungen, nicht nur per Bildschirm.

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}/state/{schluessel}  UND  users/{uid}/pdfs/{id}
    // ({sammlung} deckt beide Unter-Sammlungen ab: die synchronisierten
    // Daten ("state") und die abgelegten PDFs ("pdfs", Version 2).)
    //
    // FUER ALLE (seit 09.10.2026, Entscheidung 42 - Mirko: freiwillig, jeder
    // legt sein Konto selbst an). Bis dahin stand hier zusaetzlich
    //   && request.auth.token.email == "mirkorieb@t-online.de"
    // (nur Mirkos Konto). Jetzt darf jeder Angemeldete NUR unter seiner
    // eigenen uid lesen und schreiben - die uid-Zeile macht die Trennung.
    // Erlaubt sind nur die Sammlungen, die das Werkzeug benutzt:
    //   state (Eintraege), pdfs (abgelegte PDFs), konto (Einwilligung).
    match /users/{uid}/{sammlung}/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && sammlung in ["state", "pdfs", "konto"];
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
